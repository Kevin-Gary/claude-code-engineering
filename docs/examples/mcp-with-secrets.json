{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "internal-api": {
      "type": "http",
      "url": "${INTERNAL_API_URL:-https://internal.example.com}/mcp",
      "headers": {
        "X-Api-Key": "${INTERNAL_API_KEY}"
      }
    }
  }
}
